# Copy to .env.local and fill in. These are read ONLY on the server (Next.js API routes).
# Leave DEEPSEEK_API_KEY empty to run the clearly-labelled demo mode.
DEEPSEEK_API_KEY=

# Optional overrides
# DEEPSEEK_MODEL=deepseek-flash          # or deepseek-v4-pro (≈4x the price). Old "deepseek-chat" maps to deepseek-flash.
# DEEPSEEK_REASONING_EFFORT=none         # none (fast, default) | low | high | max — thinking tokens are billed as output
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Future provider switch (Claude provider is a stub in this PoC)
# AI_PROVIDER=deepseek
# ANTHROPIC_API_KEY=
